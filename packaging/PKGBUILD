# Maintainer: Moritz Utcke <moritz.utcke@ib-cornelsen.de>
#
# Canopy is built from the working tree this file sits in rather than from a
# downloaded source archive, because the UI is drawn by svelte-gpui, which is
# linked from a sibling checkout (`bun link @neoworks/svelte-gpui`). A clean
# chroot has no such link, so `makepkg -si` is run from here and builds what is
# checked out.

pkgname=canopy
pkgver=0.1.0
pkgrel=1
pkgdesc="A keyboard-driven file manager for the desktop"
arch=('x86_64')
url="https://neoworks.dev"
license=('MIT')
depends=(
	# GPUI draws with Vulkan and reads input through xkbcommon, on Wayland or X11.
	'vulkan-icd-loader'
	'libxkbcommon'
	'libxkbcommon-x11'
	'libxcb'
	'wayland'
	'fontconfig'
	# Thumbnails of videos and audio covers, and the audio waveform, come from ffmpeg.
	'ffmpeg'
)
makedepends=('cargo' 'bun')
optdepends=(
	'poppler: PDF thumbnails and previews'
	'ffmpegthumbnailer: faster video thumbnails'
	'git: working tree marks on entries and the branch in the status strip'
	'zoxide: jumping to a folder by frecency'
	'wl-clipboard: copying and pasting files under Wayland'
	'xclip: copying and pasting files under X11'
	'xdg-utils: opening a file in the application the desktop chose for it'
)
provides=('canopy' 'canopyd')
options=('!strip' '!debug')

# svelte-gpui's packager builds the UI bundle and compiles it into the canopy
# executable, so the program runs with nothing beside it but the daemon.
build() {
	cd "$startdir/.."
	bun install
	bun run package -- --no-tar
	cargo build --release --locked -p canopy-index --bin canopyd
}

package() {
	cd "$startdir/.."
	local target="${CARGO_TARGET_DIR:-target}"

	install -Dm755 dist/package/canopy/canopy "$pkgdir/usr/bin/canopy"
	install -Dm755 "$target/release/canopyd" "$pkgdir/usr/bin/canopyd"

	install -Dm644 packaging/canopy.desktop \
		"$pkgdir/usr/share/applications/canopy.desktop"
	install -Dm644 packaging/dev.neoworks.Canopy.metainfo.xml \
		"$pkgdir/usr/share/metainfo/dev.neoworks.Canopy.metainfo.xml"

	local size
	for size in 16 24 32 48 64 128 256 512; do
		install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/canopy.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/canopy.png"
	done

	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
